{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Path aliases — must mirror vite.config.ts aliases */
    "baseUrl": ".",
    "paths": {
      "@/*":           ["./src/*"],
      "@assets/*":     ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@config/*":     ["./src/config/*"],
      "@context/*":    ["./src/context/*"],
      "@hooks/*":      ["./src/hooks/*"],
      "@lib/*":        ["./src/lib/*"],
      "@modules/*":    ["./src/modules/*"],
      "@routes/*":     ["./src/routes/*"],
      "@services/*":   ["./src/services/*"],
      "@store/*":      ["./src/store/*"],
      "@types/*":      ["./src/types/*"]
    }
  },
  "include": ["src"]
}
