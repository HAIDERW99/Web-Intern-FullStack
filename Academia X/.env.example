# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: override the app's base URL (useful for Tauri / Electron deep links)
VITE_APP_URL=http://localhost:5173

# ── Super Admin seed credentials (DEV only) ──────────────────────────────
VITE_SUPER_ADMIN_NAME="Your Full Name"
VITE_SUPER_ADMIN_EMAIL="your-super-admin@example.com"
VITE_SUPER_ADMIN_PASSWORD="your-super-admin-password"
