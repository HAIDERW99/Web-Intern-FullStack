%% Assignment 1 - Statistics and Probability Theory
clear; clc; close all;

%% Question 1: Types of Variables & Measurement Error
fprintf('========== QUESTION 1 ==========\n'); %[output:2f8ed094]
dev_time = [5.1, 5.0, 5.3, 4.9, 5.2];
true_val = 5.0;

errors = dev_time - true_val;
abs_errors = abs(errors);
mae = mean(abs_errors);

fprintf('Mean Absolute Error: %.2f months\n\n', mae); %[output:83a8468b]

figure(1);
stem(dev_time, 'filled', 'LineWidth', 1.5); %[output:93c7a8bc]
yline(true_val, 'r--', 'True Value (5.0)', 'LineWidth', 1.5); %[output:93c7a8bc]
title('Question 1: Development Time per Observation'); %[output:93c7a8bc]
xlabel('Observation Index'); %[output:93c7a8bc]
ylabel('Development Time (Months)'); %[output:93c7a8bc]
grid on; %[output:93c7a8bc]

%% Question 2: Data Collection and Sampling
fprintf('========== QUESTION 2 ==========\n'); %[output:61583832]
N_sections = [60, 50, 70, 60];
N_total = sum(N_sections);
n_total = 24;

% Proportional sample sizes
n_strata = (N_sections / N_total) * n_total;
disp('Proportional Sample Sizes for Sections [A, B, C, D]:'); %[output:1d069df0]
disp(n_strata); %[output:47556705]

% Simple Random Sample
srs_sample = sort(randperm(N_total, n_total));
disp('SRS Selected Student IDs:'); %[output:8173834c]
disp(srs_sample); %[output:2e921045]

% Stratified Sampling
section_A = randperm(60, 6);
section_B = 60 + randperm(50, 5);
section_C = 110 + randperm(70, 7);
section_D = 180 + randperm(60, 6);
stratified_sample = [section_A, section_B, section_C, section_D];
disp('Stratified Selected IDs:'); %[output:598843a6]
disp(stratified_sample); %[output:8a416421]
fprintf('\n');

%% Question 3: Frequency Distribution of a Discrete Variable
fprintf('========== QUESTION 3 ==========\n'); %[output:3e952f60]
defects = [2, 4, 3, 5, 2, 6, 4, 3, 5, 7, 4, 2, 3, 6, 5, 4, 3, 8, 2, 5, 6, 4, 3, 5, 7, 4, 2, 6, 5, 3];
[vals, ~, idx] = unique(defects);
counts = accumarray(idx, 1);
rel_freq = counts / length(defects);
cum_freq = cumsum(counts);

T3 = table(vals', counts, rel_freq, cum_freq, ...
    'VariableNames', {'Defects', 'Frequency', 'RelativeFreq', 'CumulativeFreq'});
disp(T3); %[output:75066556]

figure(2);
bar(vals, counts, 'FaceColor', [0.2 0.5 0.8]); %[output:4d967173]
xlabel('Number of Defects'); %[output:4d967173]
ylabel('Frequency (Modules)'); %[output:4d967173]
title('Question 3: Frequency Distribution of Software Defects'); %[output:4d967173]
grid on; %[output:4d967173]
fprintf('\n');

%% Question 4: Continuous Variable & Cumulative Frequency
fprintf('========== QUESTION 4 ==========\n'); %[output:74773f5f]
rt = [112, 125, 118, 143, 156, 134, 129, 145, 151, 138, 119, 127, 133, ...
      148, 162, 155, 141, 136, 124, 130, 147, 153, 158, 121, 139, 132, ...
      146, 160, 135, 128, 142, 149, 154, 137, 126, 131, 144, 159, 150, 122];

edges4 = 110:10:170;
[counts4, edges4] = histcounts(rt, edges4);
fprintf('Min: %d, Max: %d, Sample Size: %d\n', min(rt), max(rt), length(rt)); %[output:3b155f6f]

figure(3);
subplot(1, 2, 1); %[output:2424a6a7]
histogram(rt, edges4); %[output:2424a6a7]
title('Histogram of API Response Times'); %[output:2424a6a7]
xlabel('Response Time (ms)'); %[output:2424a6a7]
ylabel('Frequency'); %[output:2424a6a7]
grid on; %[output:2424a6a7]

subplot(1, 2, 2); %[output:2424a6a7]
plot(edges4, [0, cumsum(counts4)], '-o', 'LineWidth', 1.5, 'Color', 'r'); %[output:2424a6a7]
title('Ogive (Cumulative Frequency Curve)'); %[output:2424a6a7]
xlabel('Response Time (ms)'); %[output:2424a6a7]
ylabel('Cumulative Frequency'); %[output:2424a6a7]
grid on; %[output:2424a6a7]
fprintf('\n');

%% Question 5: Frequency Curves and Presentation
fprintf('========== QUESTION 5 ==========\n'); %[output:5443c13b]
scores = [42, 55, 61, 67, 72, 74, 81, 69, 58, 63, 77, 85, 91, 48, 52, ...
          66, 71, 73, 79, 82, 88, 93, 57, 62, 68, 75, 80, 84, 87, 90, ...
          45, 50, 59, 64, 70, 76, 78, 83, 86, 89, 94, 96, 54, 60, 65, ...
          72, 74, 81, 85, 92];

edges5 = 40:10:100;
counts5 = histcounts(scores, edges5);
midpoints5 = edges5(1:end-1) + 5;

figure(4);
subplot(1, 3, 1); %[output:4de255cd]
histogram(scores, edges5); %[output:4de255cd]
title('Histogram'); xlabel('Scores'); ylabel('Frequency'); grid on; %[output:4de255cd]

subplot(1, 3, 2); %[output:724eb151]
plot(midpoints5, counts5, '-s', 'LineWidth', 1.5); %[output:724eb151]
title('Frequency Polygon'); xlabel('Midpoints'); ylabel('Frequency'); grid on; %[output:724eb151]

subplot(1, 3, 3); %[output:724eb151]
plot(edges5, [0, cumsum(counts5)], '-^r', 'LineWidth', 1.5); %[output:724eb151]
title('Cumulative Frequency (Ogive)'); xlabel('Score Boundaries'); ylabel('Cumulative Frequency'); grid on; %[output:724eb151]
fprintf('\n');

%% Question 6: Central Tendency & Execution Times
fprintf('========== QUESTION 6 ==========\n'); %[output:3cfeffa7]
exec_times = [12, 15, 17, 18, 19, 21, 21, 23, 24, 24, 25, 26, 27, 28, 28, 29, 31, 32, 34, 35, 36, 38, 41, 43, 47];

m_mean = mean(exec_times);
m_median = median(exec_times);
m_mode = mode(exec_times);
fprintf('Mean: %.2f, Median: %.1f, Mode: %.1f\n', m_mean, m_median, m_mode); %[output:39acb767]

figure(5);
subplot(1, 2, 1); %[output:67e2faa7]
boxplot(exec_times); %[output:67e2faa7]
title('Execution Times Boxplot'); ylabel('Time (s)'); grid on; %[output:67e2faa7]

subplot(1, 2, 2);
histogram(exec_times, 5);
title('Execution Times Histogram'); xlabel('Time (s)'); ylabel('Count'); grid on;
fprintf('\n');

%% Question 7: Integrated Problem (Course Marks & Coding Tests)
fprintf('========== QUESTION 7 ==========\n'); %[output:005df19d]
courses = {'Programming', 'Statistics', 'Software Eng', 'Database'};
marks = [78, 84, 91, 76];
weights = [0.30, 0.25, 0.25, 0.20];

simple_mean = mean(marks);
weighted_mean = sum(marks .* weights) / sum(weights);

coding_scores = [62, 70, 74, 74, 79, 81, 85, 88, 90, 95];
med_coding = median(coding_scores);
mode_coding = mode(coding_scores);

fprintf('Simple Mean: %.2f\n', simple_mean); %[output:0335b359]
fprintf('Weighted Mean: %.2f\n', weighted_mean); %[output:722df053]
fprintf('Coding Scores Median: %.1f, Mode: %d\n', med_coding, mode_coding); %[output:86b62331]

figure(6);
bar(categorical(courses), marks, 'FaceColor', [0.3 0.6 0.4]);
ylabel('Marks');
title('Course Marks Comparison');
grid on;

