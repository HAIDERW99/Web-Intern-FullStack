# =============================================================
# TradePro 360 — .gitignore
# =============================================================

# ── Environment secrets (NEVER commit these) ──────────────────
.env
frontend/.env
backend/.env

# Keep example files so new devs know what's needed
!.env.example
!frontend/.env.example
!backend/.env.example

# ── Node / npm ────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Vite build output ─────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── OS junk ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor config ─────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── Supabase local dev ────────────────────────────────────────
.supabase/
supabase/.branches/
supabase/.temp/
